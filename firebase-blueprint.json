{
  "entities": {
    "users": {
      "path": "users/{userId}",
      "description": "User profile records",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      }
    },
    "interactions": {
      "path": "users/{userId}/interactions/{interactionId}",
      "description": "Individual conversational reflection interactions isolated strictly to the user",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "response": { "type": "string" },
        "mode": { "type": "string" },
        "entryId": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "journalEntries": {
      "path": "users/{userId}/journalEntries/{entryId}",
      "description": "User multi-turn journal and reflection sessions with Gemini summaries and analysis",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mood": { "type": "string" },
        "tags": { "type": "array" },
        "geminiInsight": { "type": "object" },
        "interactions": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
